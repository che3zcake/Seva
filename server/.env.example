# Copy to server/.env (or the repo root) and fill in what you need.
# Everything here is optional: the prototype runs fully without any of it.

# Enables the OpenAI-backed explanations. Without it, the app uses its
# built-in deterministic explanations and nothing breaks.
OPENAI_API_KEY=

# Model used for explanations. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Port the API listens on. Defaults to 4000.
PORT=

# Where the Vite dev server runs, used for the CORS allowlist.
# Defaults to http://localhost:5173.
CLIENT_URL=
